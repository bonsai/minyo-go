    "seed:remote": "node scripts/seed-d1.mjs --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261118.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^4.45.0",
    "@cloudflare/vitest-pool-workers": "^0.8.19"
  }
}
